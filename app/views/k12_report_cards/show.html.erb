<%
# Page Schools fork (Automatic K-12 Result): the two-faced report card.
#   Face A — the termly sheet (CA/exam/total, grade, median, position, traits,
#            remarks) in senior mode, or a skills/progress sheet in
#            developmental (KG–Y4) mode.
#   Face B — per-subject strand mastery with rating bars.
# Print-ready (chrome hidden by base print CSS + .no-print), PDF via ?format=pdf.
provide :page_title, t("%{student} — Report Card", student: @student.short_name)

position_denominator = ->(set) { @config.rank_among_attempted? ? set&.attempted_count : set&.enrolled_count }
format_position = lambda do |rank, set|
  total = position_denominator.call(set)
  rank && total ? t("%{rank} of %{total}", rank: rank.ordinalize, total:) : "—"
end
format_score = ->(value) { value.nil? ? "—" : value.round(1) }
mastery_color = lambda do |color|
  c = color.to_s.strip
  if c.blank?
    "#9aa5b1"
  else
    c.start_with?("#") ? c : "##{c}"
  end
end

scores = @courses.filter_map { |c| @results_by_course[c.id]&.score }
term_average = scores.empty? ? nil : (scores.sum / scores.size).round(1)
average_band = @config.waec_band(term_average)
period_label = @grading_period ? @config.term_label(@grading_period) : t("Session (Cumulative)")
%>

<style>
  .k12rc { max-width: 860px; margin: 0 auto; font-family: "Lato Extended", Lato, Arial, sans-serif; color: #1c1b3b; }
  .k12rc-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 14px; }
  .k12rc-toolbar .pill { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid #2d3193;
                         color: #2d3193; text-decoration: none; font-size: 13px; }
  .k12rc-toolbar .pill.active { background: #2d3193; color: #fff; }
  .k12rc-toolbar .btn { margin-left: auto; }
  .k12rc-state { display: inline-block; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px;
                 letter-spacing: 1px; }
  .k12rc-state.provisional { background: #fef3cd; color: #8a6d1a; border: 1px solid #e8d48b; }
  .k12rc-state.final { background: #e3f2e5; color: #1d6629; border: 1px solid #a8d5ae; }
  .k12rc-face { border: 1px solid #c7cdd1; border-radius: 8px; padding: 24px 28px; margin-bottom: 24px; background: #fff; }
  .k12rc-head { text-align: center; border-bottom: 3px double #1c1b3b; padding-bottom: 10px; margin-bottom: 14px; }
  .k12rc-head h1 { margin: 0; font-size: 22px; letter-spacing: .5px; color: #2d3193; }
  .k12rc-head .sub { font-size: 12px; color: #555; text-transform: uppercase; letter-spacing: 2px; margin-top: 2px; }
  .k12rc-info { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 32px; font-size: 13px; margin-bottom: 14px; }
  table.k12rc-t { width: 100%; border-collapse: collapse; font-size: 12.5px; margin-bottom: 16px; }
  table.k12rc-t th, table.k12rc-t td { border: 1px solid #c7cdd1; padding: 5px 8px; text-align: left; }
  table.k12rc-t th { background: #f0f2fa; font-weight: 700; }
  table.k12rc-t .num { text-align: center; }
  .k12rc-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .k12rc-summary { display: flex; gap: 24px; flex-wrap: wrap; background: #f7f8fd; border: 1px solid #dfe3f0;
                   border-radius: 6px; padding: 10px 16px; margin-bottom: 16px; font-size: 13px; }
  .k12rc-summary b { color: #2d3193; }
  .k12rc-remarks { font-size: 13px; margin-top: 10px; }
  .k12rc-remarks .line { border-bottom: 1px dotted #8f97a3; min-height: 22px; padding: 2px 0; }
  .k12rc-bar-wrap { background: #e7eaee; border-radius: 4px; height: 12px; width: 140px; display: inline-block;
                    vertical-align: middle; }
  .k12rc-bar { height: 12px; border-radius: 4px; display: block; }
  .k12rc-ratepill { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 11px; color: #fff; }
  .k12rc-note { font-size: 11px; color: #66717d; margin-top: 6px; }
  .k12rc-manage { border: 1px dashed #b3b9c4; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;
                  background: #fbfbfd; font-size: 13px; }
  .k12rc-manage input[type=number] { width: 3.5em; }
  .k12rc-manage textarea { width: 100%; }
  @media print {
    .no-print { display: none !important; }
    .k12rc-face { border: none; padding: 0; page-break-after: always; }
  }
</style>

<div class="k12rc">
  <div class="k12rc-toolbar no-print">
    <% if @terms.size > 1 %>
      <form action="<%= user_k12_report_card_path(@student) %>" method="get" style="display:inline">
        <label for="k12rc_term"><%= t("Session:") %></label>
        <select id="k12rc_term" name="enrollment_term_id" onchange="this.form.submit()">
          <% @terms.each do |term| %>
            <option value="<%= term.id %>" <%= "selected" if @term && term.id == @term.id %>><%= term.name %></option>
          <% end %>
        </select>
      </form>
    <% end %>
    <% @periods.each do |gp| %>
      <a class="pill <%= "active" if @grading_period&.id == gp.id %>"
         href="<%= user_k12_report_card_path(@student, enrollment_term_id: @term&.id, grading_period_id: gp.id) %>"><%= @config.term_label(gp) %></a>
    <% end %>
    <a class="pill <%= "active" if @sessional %>"
       href="<%= user_k12_report_card_path(@student, enrollment_term_id: @term&.id, grading_period_id: "session") %>"><%= t("Session") %></a>
    <span class="btn">
      <a class="pill" href="<%= user_k12_report_card_path(@student, enrollment_term_id: @term&.id, grading_period_id: @grading_period&.id || "session", format: :pdf) %>"><%= t("Download PDF") %></a>
      <button class="pill" style="cursor:pointer; background:#2d3193; color:#fff" onclick="window.print()"><%= t("Print") %></button>
    </span>
  </div>

  <% if @courses.empty? %>
    <div class="k12rc-face"><%= t("No enrollments found for this session.") %></div>
  <% else %>

    <%# ───────── FACE A ───────── %>
    <div class="k12rc-face">
      <div class="k12rc-head">
        <h1><%= @domain_root_account.name %></h1>
        <div class="sub"><%= @view_mode == "developmental" ? t("Learning Progress Report") : t("Terminal Report Sheet") %></div>
        <div class="sub"><%= period_label %> · <%= @term&.name %></div>
      </div>

      <div class="k12rc-info">
        <div><b><%= t("Name:") %></b> <%= @student.name %></div>
        <div><b><%= t("Student ID:") %></b> <%= @student.pseudonym&.sis_user_id || @student.id %></div>
        <div><b><%= t("Subjects:") %></b> <%= @courses.size %></div>
        <div>
          <b><%= t("Status:") %></b>
          <% if @finalized %>
            <span class="k12rc-state final"><%= t("FINAL") %></span>
          <% else %>
            <span class="k12rc-state provisional"><%= t("PROVISIONAL") %></span>
            <span style="font-size:11px; color:#8a6d1a"><%= t("grading still in progress") %></span>
          <% end %>
        </div>
      </div>

      <% if @view_mode == "developmental" %>
        <table class="k12rc-t">
          <thead>
            <tr>
              <th><%= t("Learning Area") %></th>
              <th class="num"><%= t("Progress") %></th>
              <th><%= t("Teacher's Note") %></th>
            </tr>
          </thead>
          <tbody>
            <% @courses.each do |course| %>
              <% result = @results_by_course[course.id] %>
              <% entries = result&.mastery_entries || [] %>
              <% mastered = entries.count { |e| e["mastery"] } %>
              <tr>
                <td><%= course.name %></td>
                <td class="num">
                  <% if entries.any? %>
                    <%= t("%{mastered} of %{total} skills secure", mastered:, total: entries.size) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td><%= result&.remark || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="k12rc-note"><%= t("Skills detail is on the next page. Scores and class positions are not reported at this level.") %></div>
      <% else %>
        <table class="k12rc-t">
          <thead>
            <tr>
              <th><%= t("Subject") %></th>
              <th class="num"><%= t("CA (%{weight})", weight: @config.ca_weight.round) %></th>
              <th class="num"><%= t("Exam (%{weight})", weight: @config.exam_weight.round) %></th>
              <th class="num"><%= t("Total (100)") %></th>
              <th class="num"><%= t("Grade") %></th>
              <% if @config.show_median? %><th class="num"><%= t("Class Median") %></th><% end %>
              <% if @config.show_term_position? %><th class="num"><%= @sessional ? t("Overall Position") : t("Position") %></th><% end %>
              <th><%= t("Remark") %></th>
            </tr>
          </thead>
          <tbody>
            <% @courses.each do |course| %>
              <% result = @results_by_course[course.id] %>
              <% set = result&.k12_result_set %>
              <tr>
                <td><%= @can_manage ? link_to(course.name, course_k12_results_path(course, grading_period_id: @grading_period&.id || "session"), style: "color:inherit; text-decoration:none") : course.name %></td>
                <td class="num"><%= format_score.call(result&.ca_score) %></td>
                <td class="num"><%= format_score.call(result&.exam_score) %></td>
                <td class="num"><b><%= format_score.call(result&.score) %></b></td>
                <td class="num"><%= result&.grade || "—" %></td>
                <% if @config.show_median? %><td class="num"><%= format_score.call(set&.median) %></td><% end %>
                <% if @config.show_term_position? %><td class="num"><%= format_position.call(result&.rank, set) %></td><% end %>
                <td><%= result&.remark || @config.waec_band(result&.score)&.[](2) || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>

        <div class="k12rc-summary">
          <span><b><%= @sessional ? t("Session Average:") : t("Term Average:") %></b> <%= term_average || "—" %></span>
          <span><b><%= t("Grade:") %></b> <%= term_average ? "#{average_band[1]} (#{average_band[2]})" : "—" %></span>
          <% if @sessional && @session_result && @config.show_overall_position? %>
            <span>
              <b><%= t("Overall Position:") %></b>
              <%# traditional sessional semantics: always out of the class size
                  (all active students), regardless of the position mode %>
              <% total = @session_result.cohort_enrolled_count %>
              <%= @session_result.rank ? t("%{rank} of %{total}", rank: @session_result.rank.ordinalize, total:) : "—" %>
            </span>
            <% if @config.show_median? %>
              <span><b><%= t("Class Median Average:") %></b> <%= format_score.call(@session_result.median) %></span>
            <% end %>
          <% end %>
          <% if @sessional && @session_result %>
            <span><b><%= t("Subjects Counted:") %></b> <%= @session_result.courses_count %></span>
          <% end %>
        </div>
        <% if @config.positions_enabled? %>
          <div class="k12rc-note">
            <%= @config.rank_among_attempted? ? t("Positions are ranked among students with a graded score.") : t("Positions are ranked among all enrolled students; the count includes students not yet graded.") %>
            <% if @sessional && @config.show_overall_position? %>
              <%= t("The overall position is out of all active students in the session.") %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <div class="k12rc-cols" style="margin-top:14px">
        <table class="k12rc-t">
          <thead><tr><th><%= t("Affective Trait") %></th><th class="num"><%= t("Rating (1–5)") %></th></tr></thead>
          <tbody>
            <% affective = @session_result&.trait_ratings("affective") || {} %>
            <% (affective.keys | K12ReportCardsController::AFFECTIVE_TRAITS).each do |trait| %>
              <tr><td><%= trait %></td><td class="num"><%= affective[trait] || "—" %></td></tr>
            <% end %>
          </tbody>
        </table>
        <table class="k12rc-t">
          <thead><tr><th><%= t("Psychomotor Trait") %></th><th class="num"><%= t("Rating (1–5)") %></th></tr></thead>
          <tbody>
            <% psychomotor = @session_result&.trait_ratings("psychomotor") || {} %>
            <% (psychomotor.keys | K12ReportCardsController::PSYCHOMOTOR_TRAITS).each do |trait| %>
              <tr><td><%= trait %></td><td class="num"><%= psychomotor[trait] || "—" %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="k12rc-remarks">
        <div><b><%= t("Class Teacher's Remark:") %></b></div>
        <div class="line"><%= @session_result&.class_teacher_remark %></div>
        <div style="margin-top:8px"><b><%= t("Head Teacher's Remark:") %></b></div>
        <div class="line"><%= @session_result&.head_teacher_remark %></div>
      </div>
    </div>

    <%# ───────── FACE B — strand mastery ───────── %>
    <% if @config.show_mastery? %>
      <div class="k12rc-face">
        <div class="k12rc-head">
          <h1><%= t("Skills & Strand Mastery") %></h1>
          <div class="sub"><%= @student.name %> · <%= period_label %></div>
        </div>
        <% any_mastery = false %>
        <% @courses.each do |course| %>
          <% entries = @results_by_course[course.id]&.mastery_entries || [] %>
          <% next if entries.empty? %>
          <% any_mastery = true %>
          <div style="font-weight:700; font-size:13px; margin:10px 0 4px"><%= course.name %></div>
          <table class="k12rc-t">
            <thead>
              <tr>
                <th><%= t("Strand / Skill") %></th>
                <th class="num"><%= t("Mastery") %></th>
                <th class="num"><%= t("Score") %></th>
                <th><%= t("Progress") %></th>
              </tr>
            </thead>
            <tbody>
              <% entries.group_by { |e| e["strand"] }.each do |strand, strand_entries| %>
                <% strand_entries.each_with_index do |entry, index| %>
                  <tr>
                    <td>
                      <% if index.zero? && strand %><b><%= strand %>:</b> <% end %>
                      <%= entry["title"] %>
                    </td>
                    <td class="num">
                      <span class="k12rc-ratepill" style="background: <%= mastery_color.call(entry["color"]) %>"><%= entry["rating"] || t("No data") %></span>
                    </td>
                    <td class="num">
                      <%= entry["score"] %><% if entry["points_possible"] %> / <%= entry["points_possible"] %><% end %>
                    </td>
                    <td>
                      <% if entry["points_possible"].to_f.positive? %>
                        <span class="k12rc-bar-wrap"><span class="k12rc-bar" style="width: <%= [(entry["score"].to_f / entry["points_possible"].to_f * 100).round, 100].min %>%; background: <%= mastery_color.call(entry["color"]) %>"></span></span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% end %>
        <% unless any_mastery %>
          <div class="k12rc-note"><%= t("No outcome mastery has been assessed for this period yet.") %></div>
        <% end %>
        <div class="k12rc-note">
          <%= t("Mastery comes from Canvas outcome results (rubrics and quizzes), rolled up with the school's mastery scale.") %>
        </div>
      </div>
    <% end %>

    <%# ───────── staff panel ───────── %>
    <% if @can_manage && @term %>
      <div class="k12rc-manage no-print">
        <b><%= t("Staff: traits & remarks") %></b>
        <div class="k12rc-note" style="margin-bottom:8px"><%= t("Per-subject remarks are edited on each course's K-12 Results page (click a subject name). These fields are session-wide and survive recomputes.") %></div>
        <%= form_tag user_k12_report_card_path(@student), method: :put do %>
          <%= hidden_field_tag :enrollment_term_id, @term.id %>
          <%= hidden_field_tag :grading_period_id, @grading_period&.id || "session" %>
          <div class="k12rc-cols">
            <div>
              <% K12ReportCardsController::AFFECTIVE_TRAITS.each do |trait| %>
                <label style="display:block"><%= trait %>
                  <input type="number" min="1" max="5" name="traits[affective][<%= trait %>]"
                         value="<%= @session_result&.trait_ratings("affective")&.[](trait) %>">
                </label>
              <% end %>
            </div>
            <div>
              <% K12ReportCardsController::PSYCHOMOTOR_TRAITS.each do |trait| %>
                <label style="display:block"><%= trait %>
                  <input type="number" min="1" max="5" name="traits[psychomotor][<%= trait %>]"
                         value="<%= @session_result&.trait_ratings("psychomotor")&.[](trait) %>">
                </label>
              <% end %>
            </div>
          </div>
          <label style="display:block; margin-top:8px"><%= t("Class Teacher's Remark") %>
            <textarea name="class_teacher_remark" rows="2"><%= @session_result&.class_teacher_remark %></textarea>
          </label>
          <label style="display:block; margin-top:8px"><%= t("Head Teacher's Remark") %>
            <textarea name="head_teacher_remark" rows="2"><%= @session_result&.head_teacher_remark %></textarea>
          </label>
          <button type="submit" style="margin-top:8px"><%= t("Save") %></button>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
