# Page Schools fork (Moments)
%>

<%= fields_for :settings do |f| %>
  <table style="width: 500px;" class="formtable">
    <tr>
      <td colspan="2">
        <p><%= t(<<~TEXT)
          The Moments media backend cuts identity-blind highlight clips and
          compiles per-child reels. By default this is the moments-worker
          service that ships in the docker compose stack; point Base URL at a
          remote deployment to run it elsewhere. The shared secret signs
          requests in both directions.
          TEXT
        %></p>
      </td>
    </tr>
    <tr>
      <td><%= f.blabel :base_url, en: "Base URL" %></td>
      <td><%= f.text_field :base_url, value: settings[:base_url] %></td>
    </tr>
    <tr>
      <td><%= f.blabel :shared_secret, en: "Shared Secret" %></td>
      <td><%= f.password_field :shared_secret, value: settings[:shared_secret], autocomplete: "new-password" %></td>
    </tr>
  </table>
<% end %>
