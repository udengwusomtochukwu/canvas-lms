# Page Schools fork (Moments): teacher session list + upload for one course.
%>

<% provide :page_title do %><%= t("Moments: %{course}", course: @context.name) %><% end %>

<div class="TopLinks">
  <a href="<%= moments_path %>" class="btn"><i class="icon-arrow-left"></i> <%= t("All Moments") %></a>
  <a href="<%= course_moments_consents_path(@context) %>" class="btn"><%= t("Consent") %></a>
</div>

<h1 class="Heading"><%= t("Moments — %{course}", course: @context.name) %></h1>

<h2 class="Heading"><%= t("Upload a recording") %></h2>
<p>
  <%= t(<<~TEXT)
    The video goes straight to the Moments media backend, which cuts
    identity-blind highlight clips (no face recognition, ever). You then tag
    consented students on each clip and review captions before anything is
    shared. Raw recordings are purged automatically after compilation.
    TEXT
  %>
</p>

<form id="moments-upload-form">
  <label><%= t("Title") %> <input type="text" name="title" required maxlength="255"></label>
  <label><%= t("Date") %> <input type="date" name="captured_at" value="<%= Time.zone.today.iso8601 %>"></label>
  <label><%= t("Highlight length (seconds)") %> <input type="number" name="clip_seconds" min="5" max="120" value="30"></label>
  <label><%= t("Video file") %> <input type="file" name="video" accept="video/*" required></label>
  <button type="submit" class="btn btn-primary"><%= t("Upload") %></button>
  <span id="moments-upload-status" role="status"></span>
</form>

<h2 class="Heading"><%= t("Sessions") %></h2>
<% if @sessions.empty? %>
  <p><%= t("No sessions yet.") %></p>
<% else %>
  <table class="ic-Table">
    <thead>
      <tr>
        <th scope="col"><%= t("Title") %></th>
        <th scope="col"><%= t("Date") %></th>
        <th scope="col"><%= t("Status") %></th>
      </tr>
    </thead>
    <tbody>
      <% @sessions.each do |session| %>
        <tr>
          <th scope="row"><a href="<%= course_moments_session_path(@context, session) %>"><%= session.title %></a></th>
          <td><%= datetime_string(session.captured_at, :no_time) %></td>
          <td><%= session.workflow_state %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<script>
(function () {
  "use strict";
  var form = document.getElementById("moments-upload-form");
  var status = document.getElementById("moments-upload-status");
  if (!form) return;

  function csrfToken() {
    var match = document.cookie.match(/(^|;\s*)_csrf_token=([^;]+)/);
    return match ? decodeURIComponent(match[2]) : "";
  }

  form.addEventListener("submit", function (event) {
    event.preventDefault();
    var file = form.elements.video.files[0];
    if (!file) return;
    status.textContent = <%= t("Creating session...").to_json.html_safe %>;

    var body = new URLSearchParams({
      title: form.elements.title.value,
      captured_at: form.elements.captured_at.value,
      clip_seconds: form.elements.clip_seconds.value,
      content_type: file.type || "video/mp4"
    });

    fetch("<%= course_moments_sessions_path(@context) %>", {
      method: "POST",
      headers: { "X-CSRF-Token": csrfToken(), "Accept": "application/json", "Content-Type": "application/x-www-form-urlencoded" },
      body: body.toString(),
      credentials: "same-origin"
    })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        if (data.error) throw new Error(data.error);
        status.textContent = <%= t("Uploading video...").to_json.html_safe %>;
        return fetch(data.upload_url, { method: "PUT", body: file, headers: { "Content-Type": file.type || "video/mp4" } })
          .then(function (put) {
            if (!put.ok) throw new Error("upload failed (" + put.status + ")");
            status.textContent = <%= t("Starting processing...").to_json.html_safe %>;
            return fetch("<%= course_moments_sessions_path(@context) %>/" + data.session_id + "/ingest", {
              method: "POST",
              headers: { "X-CSRF-Token": csrfToken(), "Accept": "application/json" },
              credentials: "same-origin"
            });
          })
          .then(function () { window.location.href = data.show_url; });
      })
      .catch(function (error) { status.textContent = error.message; });
  });
}());
</script>
