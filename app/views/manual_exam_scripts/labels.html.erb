# Page Schools fork (Manual Exam Workflow): printable QR labels, one per
# student, to affix to exam scripts before scanning. Rendered without the
# app layout so it prints cleanly.
%>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <title><%= t("QR Labels: %{assignment}", assignment: @assignment.title) %></title>
  <style>
    body { font-family: sans-serif; margin: 1rem; }
    .labels { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .label {
      border: 1px dashed #999;
      padding: 0.5rem;
      width: 220px;
      text-align: center;
      page-break-inside: avoid;
    }
    .label svg { width: 90px; height: 90px; }
    .label .name { font-size: 0.9rem; font-weight: bold; }
    .label .meta { font-size: 0.75rem; color: #333; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <p class="no-print">
    <button onclick="window.print()"><%= t("Print") %></button>
    <%= t(<<~TEXT)
      Affix one label per student to their exam script before scanning. The QR
      code (or the student ID written as a filename prefix, e.g. "1234_scan.pdf")
      lets the bulk upload route each scan to the right student.
      TEXT
    %>
  </p>
  <h1><%= t("%{assignment} — %{course}", assignment: @assignment.title, course: @context.name) %></h1>
  <div class="labels">
    <% @students.each do |student| %>
      <div class="label">
        <%= raw @qr_codes[student.id] %>
        <div class="name"><%= student.sortable_name %></div>
        <div class="meta"><%= t("Student ID: %{id}", id: student.id) %></div>
      </div>
    <% end %>
  </div>
</body>
</html>
