<%
# Page Schools fork (Automatic K-12 Result): teacher/admin view of one
# course's computed result set — per grading period or sessional — with
# per-student subject remarks, the view-mode toggle and a manual recalculate.
provide :page_title, t("%{course}: K-12 Results", course: @context.name)
selected_period_param = @grading_period&.id || "session"
%>

<style>
  .k12r { max-width: 1000px; }
  .k12r-toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 10px 0 14px; }
  .k12r-toolbar .pill { display: inline-block; padding: 4px 14px; border-radius: 999px; border: 1px solid #2d3193;
                        color: #2d3193; text-decoration: none; font-size: 13px; }
  .k12r-toolbar .pill.active { background: #2d3193; color: #fff; }
  .k12r-stats { display: flex; gap: 20px; flex-wrap: wrap; background: #f7f8fd; border: 1px solid #dfe3f0;
                border-radius: 6px; padding: 8px 14px; margin-bottom: 12px; font-size: 13px; }
  table.k12r-t { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.k12r-t th, table.k12r-t td { border: 1px solid #c7cdd1; padding: 5px 8px; text-align: left; }
  table.k12r-t th { background: #f0f2fa; }
  table.k12r-t .num { text-align: center; }
  .k12r-state { display: inline-block; padding: 2px 10px; border-radius: 4px; font-weight: 700; font-size: 12px; }
  .k12r-state.provisional { background: #fef3cd; color: #8a6d1a; }
  .k12r-state.final { background: #e3f2e5; color: #1d6629; }
  .k12r-remark-form { display: flex; gap: 4px; }
  .k12r-remark-form input[type=text] { width: 100%; font-size: 12px; }
</style>

<div class="k12r">
  <h1 style="font-size:20px"><%= t("K-12 Results") %></h1>

  <div class="k12r-toolbar">
    <% @periods.each do |gp| %>
      <a class="pill <%= "active" if @grading_period&.id == gp.id %>"
         href="<%= course_k12_results_path(@context, grading_period_id: gp.id) %>"><%= @config.term_label(gp) %></a>
    <% end %>
    <a class="pill <%= "active" if @grading_period.nil? %>"
       href="<%= course_k12_results_path(@context, grading_period_id: "session") %>"><%= t("Session") %></a>
    <span style="margin-left:auto">
      <%= form_tag course_k12_results_recalculate_path(@context), method: :post, style: "display:inline" do %>
        <%= hidden_field_tag :grading_period_id, selected_period_param %>
        <button type="submit" class="pill" style="cursor:pointer"><%= t("Recalculate now") %></button>
      <% end %>
    </span>
  </div>

  <div class="k12r-stats">
    <%= form_tag course_k12_results_view_mode_path(@context), method: :put, style: "display:inline" do %>
      <%= hidden_field_tag :grading_period_id, selected_period_param %>
      <label><b><%= t("Report card view:") %></b>
        <select name="view_mode" onchange="this.form.submit()">
          <option value="senior" <%= "selected" if @view_mode == "senior" %>><%= t("Senior (CA + exam + positions)") %></option>
          <option value="developmental" <%= "selected" if @view_mode == "developmental" %>><%= t("Developmental (KG–Y4 skills view)") %></option>
        </select>
      </label>
    <% end %>
    <% if @result_set %>
      <span><b><%= t("Median:") %></b> <%= @result_set.median&.round(1) || "—" %></span>
      <span><b><%= t("Mean:") %></b> <%= @result_set.mean&.round(1) || "—" %></span>
      <span><b><%= t("Enrolled:") %></b> <%= @result_set.enrolled_count %></span>
      <span><b><%= t("Graded:") %></b> <%= @result_set.attempted_count %></span>
      <span>
        <% if @result_set.finalized? %>
          <span class="k12r-state final"><%= t("FINAL") %></span>
        <% else %>
          <span class="k12r-state provisional"><%= t("PROVISIONAL") %></span>
        <% end %>
      </span>
      <span style="color:#66717d"><%= t("Computed %{when}", when: datetime_string(@result_set.computed_at)) %></span>
    <% end %>
  </div>

  <% if @result_set.nil? || @results.empty? %>
    <p><%= t("No results computed yet for this view. Grade something (results follow automatically within a minute) or use \"Recalculate now\".") %></p>
  <% else %>
    <table class="k12r-t">
      <thead>
        <tr>
          <th><%= t("Position") %></th>
          <th><%= t("Student") %></th>
          <th class="num"><%= t("CA (%{weight})", weight: @config.ca_weight.round) %></th>
          <th class="num"><%= t("Exam (%{weight})", weight: @config.exam_weight.round) %></th>
          <th class="num"><%= t("Total") %></th>
          <th class="num"><%= t("Grade") %></th>
          <th style="width:34%"><%= t("Subject Remark") %></th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |result| %>
          <tr>
            <td class="num"><%= result.rank ? result.rank.ordinalize : "—" %></td>
            <td><%= link_to result.user.name, user_k12_report_card_path(result.user, enrollment_term_id: @context.enrollment_term_id, grading_period_id: selected_period_param) %></td>
            <td class="num"><%= result.ca_score&.round(1) || "—" %></td>
            <td class="num"><%= result.exam_score&.round(1) || "—" %></td>
            <td class="num"><b><%= result.score&.round(1) || "—" %></b></td>
            <td class="num"><%= result.grade || "—" %></td>
            <td>
              <%= form_tag course_k12_results_remark_path(@context, result.user_id), method: :put, class: "k12r-remark-form" do %>
                <%= hidden_field_tag :grading_period_id, selected_period_param %>
                <input type="text" name="remark" value="<%= result.remark %>" placeholder="<%= t("Add a remark…") %>">
                <button type="submit"><%= t("Save") %></button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p style="font-size:12px; color:#66717d; margin-top:8px">
      <%= t("Scores come from the gradebook (posted grades, this view's grading period). Positions use competition ranking; students without a graded score are unranked.") %>
    </p>
  <% end %>
</div>
